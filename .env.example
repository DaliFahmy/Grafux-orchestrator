# ── Service Identity ──────────────────────────────────────────────────────────
SERVICE_NAME=grafux-orchestrator
ENVIRONMENT=development
DEBUG=false
PORT=8000

# ── Grafux-backend (source of truth for auth / projects / orgs) ───────────────
BACKEND_URL=http://localhost:8001
INTERNAL_SERVICE_SECRET=change_me_to_a_long_random_secret

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# On Render: set DATABASE_URL to the Internal Database URL from your PostgreSQL
# service dashboard (format: postgres://user:pass@host:5432/dbname).
# The app normalises the scheme automatically — you do NOT need DATABASE_SYNC_URL
# unless you want to use a different URL for Alembic/LangGraph.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/grafux_orchestrator
# Optional: explicit psycopg URL for Alembic + LangGraph checkpointer.
# Leave blank to derive automatically from DATABASE_URL.
DATABASE_SYNC_URL=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Celery uses separate Redis DBs to avoid key collisions
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Gemini (voice / multimodal) ───────────────────────────────────────────────
GEMINI_API_KEY=

# ── E2B Code Interpreter ──────────────────────────────────────────────────────
E2B_API_KEY=

# ── Research ──────────────────────────────────────────────────────────────────
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# ── Internal Service URLs ─────────────────────────────────────────────────────
MCP_SERVICE_URL=http://localhost:8002
DEVICES_SERVICE_URL=http://localhost:8003
INTERACTION_SERVICE_URL=http://localhost:8004

# ── Execution Limits ──────────────────────────────────────────────────────────
MAX_EXECUTION_STEPS=50
MAX_EXECUTION_TIMEOUT=3600
SANDBOX_TIMEOUT=300

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
